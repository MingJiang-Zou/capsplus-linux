#!/bin/sh
# keyd 用：keyd 的 command(...) 以 root 执行，拉 GUI 必须降权 + 带用户会话环境。
# 用法（keyd 配置里）：command(/home/zmj/project/private/capsplus-linux/bin/keyd-qbar-cmd)
# 效果：Qbar 已开 -> 切换显示/隐藏（Qbar 自己的 socket 单实例负责），没开 -> 起一个。
set -eu
exec runuser -u zmj -- env \
  XDG_RUNTIME_DIR=/run/user/1000 \
  WAYLAND_DISPLAY=wayland-0 \
  DISPLAY=:0 \
  DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
  /home/zmj/.local/bin/capsplus-qbar "$@"
